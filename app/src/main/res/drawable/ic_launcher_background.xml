<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer for the GymLogger adaptive launcher icon.
  Solid black (#000000) — matches the app's dark theme. The barbell silhouette
  in the foreground is rendered in electric yellow.
  Fills the entire 108x108dp adaptive icon surface; the launcher may crop the corners
  depending on the user's icon shape preference (squircle is the modern default).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
