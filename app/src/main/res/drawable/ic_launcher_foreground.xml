<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer for the GymLogger adaptive launcher icon.
  Electric yellow (#D4FF3F) barbell silhouette centered in the 108x108dp canvas.
  All elements stay within the inner 66x66dp safe zone (x: 21..87, y: 21..87)
  so the launcher won't crop any of the design when it masks corners.

  Design: a horizontal bar with two stacked weight plates on each end —
  classic barbell silhouette, instantly readable as a fitness/lifting app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Center bar (horizontal grip) -->
    <path
        android:fillColor="#D4FF3F"
        android:pathData="M32,52 L76,52 L76,56 L32,56 Z" />

    <!-- Left outer plate (larger) -->
    <path
        android:fillColor="#D4FF3F"
        android:pathData="M23,38 L31,38 L31,70 L23,70 Z" />

    <!-- Left inner plate (smaller) -->
    <path
        android:fillColor="#D4FF3F"
        android:pathData="M32,43 L37,43 L37,65 L32,65 Z" />

    <!-- Right inner plate (smaller) -->
    <path
        android:fillColor="#D4FF3F"
        android:pathData="M71,43 L76,43 L76,65 L71,65 Z" />

    <!-- Right outer plate (larger) -->
    <path
        android:fillColor="#D4FF3F"
        android:pathData="M77,38 L85,38 L85,70 L77,70 Z" />
</vector>
